# BeaverBids environment variables.
# Copy to .env for local development. Every variable the code reads is listed
# here; variables for AWS and MixRoute are added in the milestones that use them.

# ---- Database (web app, worker, Prisma CLI) --------------------------------
# PostgreSQL connection string. Local Postgres from `docker compose up -d`:
DATABASE_URL="postgresql://beaverbids:beaverbids@localhost:5432/beaverbids?schema=public"

# ---- Better Auth (web app) -------------------------------------------------
# Secret used to sign session cookies. At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the web app, no trailing slash. Cookies and redirects use it.
BETTER_AUTH_URL="http://localhost:3000"

# ---- Sentry (web app and worker). All optional; nothing is sent when unset. --
# Server-side DSN for the Next.js server, the edge runtime and the worker.
SENTRY_DSN=""
# Browser DSN, inlined at build time. Usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=""
# Environment label shown in Sentry: development, staging or production.
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Release name, usually the git commit SHA. Set as a build arg in Docker.
SENTRY_RELEASE=""
# Build-time only: lets `next build` upload source maps. Leave blank to skip.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- Runtime --------------------------------------------------------------
# Port the web app listens on. Dockerfile.web sets 3000.
PORT="3000"

# ---- Landing page (web app, inlined at build time) --------------------------
# Address the "Book my demo" form opens an email to. Shown in the page copy too.
NEXT_PUBLIC_DEMO_REQUEST_EMAIL="demos@beaverbids.ca"
# Set to 1 on staging so search engines never index the unapproved landing copy.
NEXT_PUBLIC_SITE_NOINDEX=""

# ---- Ingestion (worker) ----------------------------------------------------
# Override of the CanadaBuys open tender notices file, for staging or tests.
# Blank uses the official URL built into the adapter.
CANADABUYS_OPEN_TENDERS_URL=""
# "on" registers the daily import schedule (14:00 UTC for CanadaBuys). Set it
# on staging and production only; off (the default) removes any schedule a
# previous worker left, so a laptop or CI worker never imports on its own.
INGEST_SCHEDULE=""
# Comma-separated source codes to import once when the worker starts, for
# development ("canadabuys"). Leave blank in production: the schedule runs it.
INGEST_ON_STARTUP=""

# ---- Raw source files (worker) ---------------------------------------------
# Each import keeps the downloaded file before parsing it. S3 when S3_BUCKET is
# set (credentials from the standard AWS variables), else RAW_FILES_DIR on disk.
# Production refuses to start without S3_BUCKET; staging may run on disk with
# RAW_FILES_DIR on a persistent volume.
S3_BUCKET=""
S3_PREFIX=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
RAW_FILES_DIR=".data/raw"
