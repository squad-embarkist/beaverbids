// BeaverBids database schema.
//
// Better Auth tables (user, session, account, verification) are generated by
// `npx auth@latest generate --config src/lib/auth.ts`; the three extra user
// columns (language, digestOptIn, digestConsentAt) come from
// user.additionalFields in src/lib/auth.ts. pg-boss keeps its own tables in
// the "pgboss" schema and is never modelled here.
//
// Product tables (M1): CompanyProfile, Source, IngestRun, Tender, Score.
// Codes stored in String and String[] columns (categories, buyer types,
// regions, team size bands) are validated against src/lib/schemas/vocab.ts.
// Money is whole CAD dollars.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth
// ---------------------------------------------------------------------------

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  language        String?   @default("en")
  digestOptIn     Boolean?  @default(false)
  digestConsentAt DateTime?
  sessions        Session[]
  accounts        Account[]
  companyProfile  CompanyProfile?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------

/// Language a company can deliver in, or the language a tender is submitted in.
enum Language {
  EN
  FR
  EN_FR
}

enum ScoreBand {
  HIGH
  MEDIUM
  LOW
}

enum IngestRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// The five questionnaire steps, one profile per user in phase 1.
model CompanyProfile {
  id                 String   @id @default(uuid(7))
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Step 1, company basics
  name               String
  website            String?
  headOfficeProvince String?
  capacity           String?  // team size band code, see TEAM_SIZE_BANDS
  /// Step 2, what you do
  categories         String[] @default([])
  buyerTypes         String[] @default([])
  description        String?  // the work you most want to win
  languages          Language @default(EN)
  /// Step 3, where you work
  regions            String[] @default([])
  /// Step 4, size of work, in CAD dollars
  sizeMin            Int?
  sizeMax            Int?
  timelinePref       Int?     // minimum days needed to respond
  /// Step 5, credentials
  certifications     String[] @default([])
  bonding            Boolean  @default(false)
  securityClearance  String?  // clearance level code, see CLEARANCE_LEVELS; null means none
  /// Listed in the Indigenous Business Directory. Stored from M3; the gate
  /// and the conditional set-aside reading use it in M4 (docs/plans/m2-category-cap.md).
  indigenousBusiness Boolean  @default(false)
  /// Highest questionnaire step completed, 0 to 5
  questionnaireStep  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scores             Score[]

  @@map("company_profile")
}

/// One row per data source. Only canadabuys at launch; more rows only with
/// written permission saved in docs/permissions. The fixtures source holds
/// fictional seed data and is never active.
model Source {
  id            String      @id @default(uuid(7))
  code          String      @unique
  name          String
  baseUrl       String
  active        Boolean     @default(false)
  lastSuccessAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  ingestRuns    IngestRun[]
  tenders       Tender[]

  @@map("source")
}

/// One row per import attempt. Drives the failure and zero-row alerts.
model IngestRun {
  id         String          @id @default(uuid(7))
  sourceId   String
  source     Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  status     IngestRunStatus @default(RUNNING)
  rowsFound  Int?
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([sourceId, startedAt])
  @@map("ingest_run")
}

/// A published opportunity. Amendments update the existing row, never a second one.
model Tender {
  id            String   @id @default(uuid(7))
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId    String
  title         String
  buyer         String
  buyerType     String?  // see BUYER_TYPE_CODES
  description   String
  categoryCodes String[] @default([])
  region        String   // province code, or CA for all of Canada
  valueMin      Int?
  valueMax      Int?
  publishedAt   DateTime
  closesAt      DateTime
  language      Language @default(EN)
  /// Link to the notice on the source portal. Null when the source file has
  /// no link (more than half of CanadaBuys notices); the screen falls back
  /// to the source's own site plus the reference number.
  officialUrl   String?
  rawFileKey    String?  // S3 key of the raw daily file this row came from
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scores        Score[]

  @@unique([sourceId, externalId])
  @@index([closesAt])
  @@map("tender")
}

/// One score per tender and company profile. Rules set the number; AI only
/// writes the reasons.
model Score {
  id           String         @id @default(uuid(7))
  tenderId     String
  tender       Tender         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  profileId    String
  profile      CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  total        Int
  band         ScoreBand
  eligible     Boolean        @default(true)
  /// { category, location, size, timeline, credentials } points
  factors      Json
  /// { inFavour, gaps, ruleOut, summary: { code, params, text }[] }, see src/lib/scoring/reasons.ts
  reasons      Json
  modelVersion String
  scoredAt     DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenderId, profileId])
  @@index([profileId, total(sort: Desc)])
  @@map("score")
}
